# ============================================================
# Infinity Agents — local deployment configuration
# ============================================================
# Copy to .env.local and replace placeholder values.
#   cp .env.local.example .env.local
#
# .env.local is gitignored and must never be committed.

# --- Infrastructure (Docker: PostgreSQL + Redis) ---------------

POSTGRES_DB=infinity_local
POSTGRES_USER=infinity
POSTGRES_PASSWORD=replace-with-a-strong-password
PG_PORT=5432

REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_PORT=6379

# --- API configuration (runs on host via uvicorn) --------------

# Derived from the above; update if PG/Redis are external.
DATABASE_URL=postgresql://infinity:replace-with-a-strong-password@localhost:5432/infinity_local
REDIS_URL=redis://:replace-with-a-strong-redis-password@localhost:6379/0

# Redis namespace (required for Worker enrollment and outbox coordination).
REDIS_NAMESPACE=infinity_local

APP_ENV=development
API_PORT=8008
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Migrations run automatically on API startup when APP_ENV=development.
# Set to 0 to disable auto-migration (e.g. production).
DB_MIGRATIONS_ENABLED=1

# --- Storage paths (host filesystem) ----------------------------

ARTIFACT_STORAGE_ROOT=./local-data/task-outputs
ARTIFACT_DOWNLOAD_ROOT=./local-data/task-outputs
METHOD_SOURCE_UPLOAD_ROOT=./local-data/task-inputs/method-sources
DATASET_UPLOAD_ROOT=./local-data/task-inputs/datasets

# --- Worker configuration (runs on host via consumer_v2) -------

# Control plane URL — points to the local API.
WORKER_CONTROL_PLANE_URL=http://localhost:8008

# Worker 1 — fill after running scripts/enroll-worker.sh
WORKER_1_ID=
WORKER_1_CREDENTIAL=

# Worker 2 (optional) — fill for additional Workers
# WORKER_2_ID=
# WORKER_2_CREDENTIAL=

# Claude provider — ONLY passed to Worker processes.
# Never set these in the API or frontend environment.
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
