# Local acceptance configuration. Copy to .env.local and replace the values.
# Use a fresh RUN_ID for every acceptance run; keep passwords URL-safe.
ACCEPTANCE_RUN_ID=accept_YYYYMMDD_HHMMSS
ACCEPTANCE_API_PORT=18008
ACCEPTANCE_FRONTEND_PORT=13000

ACCEPTANCE_POSTGRES_DB=infinity_acceptance
ACCEPTANCE_POSTGRES_USER=app_user
ACCEPTANCE_POSTGRES_PASSWORD=replace-with-local-db-password

ACCEPTANCE_REDIS_PASSWORD=replace-with-local-redis-password
ACCEPTANCE_WORKER_A_REDIS_PASSWORD=replace-with-worker-a-redis-password
ACCEPTANCE_WORKER_B_REDIS_PASSWORD=replace-with-worker-b-redis-password
ACCEPTANCE_REDIS_NAMESPACE=${ACCEPTANCE_RUN_ID}
ACCEPTANCE_SESSION_COOKIE_SECRET=replace-with-local-session-secret

# DATABASE_URL and REDIS_URL are derived inside the Compose services.

ARTIFACT_STORAGE_ROOT=/workspace/task-outputs
ARTIFACT_DOWNLOAD_ROOT=/workspace/task-outputs
METHOD_SOURCE_UPLOAD_ROOT=/workspace/task-inputs/method-sources
DATASET_UPLOAD_ROOT=/workspace/task-inputs/datasets
GOAL_DRIVEN_FIXTURE_ROOT=
ACCEPTANCE_FIXTURE_HOST_ROOT=/absolute/path/to/fixture/root
CODE_AGENT_DOCKER_IMAGE=claude-code-env:v2
CODE_AGENT_EXECUTOR_MODE=fixture
ALLOW_FIXTURE_EXECUTOR=1

# This is intentionally explicit in acceptance. It is not a production claim.
CODE_AGENT_JOB_NETWORK=none

# Set to 1 only after issuing one-time enrollment tokens through the local
# admin flow; the token is never persisted in source control.
ACCEPTANCE_WORKER_ENROLLMENT_REQUIRED=0
