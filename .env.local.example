# Local acceptance configuration. Copy to .env.local and replace the values.
# Use a fresh RUN_ID for every acceptance run; keep passwords URL-safe.
ACCEPTANCE_RUN_ID=accept_YYYYMMDD_HHMMSS
ACCEPTANCE_API_PORT=18008
ACCEPTANCE_FRONTEND_PORT=13000
ACCEPTANCE_NPMRC=/absolute/path/to/.npmrc
CORS_ALLOWED_ORIGINS=https://infinity.zhangyvjing.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:13000,http://127.0.0.1:13000,http://localhost:13001,http://127.0.0.1:13001

ACCEPTANCE_POSTGRES_DB=infinity_acceptance
ACCEPTANCE_POSTGRES_USER=app_bootstrap
ACCEPTANCE_POSTGRES_PASSWORD=replace-with-local-bootstrap-password
ACCEPTANCE_ADMIN_USER=app_bootstrap
ACCEPTANCE_ADMIN_PASSWORD=replace-with-local-bootstrap-password
# These are separate non-superuser service logins. Create them as the
# bootstrap/admin role before applying scripts/rls_roles.sql.
ACCEPTANCE_API_DB_USER=acceptance_api
ACCEPTANCE_API_DB_PASSWORD=replace-with-api-db-password
ACCEPTANCE_TRUST_ISSUER_DB_USER=acceptance_trust_issuer
ACCEPTANCE_TRUST_ISSUER_DB_PASSWORD=replace-with-trust-issuer-db-password
ACCEPTANCE_OUTBOX_DB_USER=acceptance_outbox
ACCEPTANCE_OUTBOX_DB_PASSWORD=replace-with-outbox-db-password
ACCEPTANCE_WORKER_A_DB_USER=acceptance_worker_a
ACCEPTANCE_WORKER_A_DB_PASSWORD=replace-with-worker-a-db-password
ACCEPTANCE_WORKER_B_DB_USER=acceptance_worker_b
ACCEPTANCE_WORKER_B_DB_PASSWORD=replace-with-worker-b-db-password
ACCEPTANCE_WORKER_GATEWAY_DB_USER=acceptance_worker_gateway
ACCEPTANCE_WORKER_GATEWAY_DB_PASSWORD=replace-with-worker-gateway-db-password
ACCEPTANCE_REAPER_DB_USER=acceptance_reaper
ACCEPTANCE_REAPER_DB_PASSWORD=replace-with-reaper-db-password
# Preflight requires the operator-installed RLS roles/policies by default.
# Set to 0 only for an explicitly disposable UI-only smoke run.
ACCEPTANCE_REQUIRE_RLS=1
# Acceptance services use separate runtime RLS logins; roles/policies must be
# installed with scripts/rls_roles.sql before starting workers.
DB_RLS_ENABLED=1
DB_RLS_REQUIRE_CONTEXT=1

ACCEPTANCE_REDIS_PASSWORD=replace-with-local-redis-password
ACCEPTANCE_WORKER_A_REDIS_PASSWORD=replace-with-worker-a-redis-password
ACCEPTANCE_WORKER_B_REDIS_PASSWORD=replace-with-worker-b-redis-password
ACCEPTANCE_WORKER_A_CREDENTIAL=
ACCEPTANCE_WORKER_B_CREDENTIAL=
ACCEPTANCE_REDIS_NAMESPACE=${ACCEPTANCE_RUN_ID}
ACCEPTANCE_SESSION_COOKIE_SECRET=replace-with-local-session-secret
ACCEPTANCE_RLS_USER_CONTEXT_SECRET=replace-with-a-long-random-rls-context-secret
# Production must provide a distinct MODEL_GATEWAY_SIGNING_SECRET. Acceptance
# compose derives it from ACCEPTANCE_SESSION_COOKIE_SECRET above.
AUTH_DEV_LOGIN_USER_ID=acceptance_api

# Worker enrollment is fail-closed in acceptance. Put operator user IDs
# here before using the Add Worker control.
WORKER_ENROLLMENT_ADMIN_USER_IDS=
# Only signed OIDC roles or these explicit user IDs receive full-trust
# Workers. Everyone else is issued a general-trust Worker.
SUPERUSER_USER_IDS=

# Only set this to 1 for an explicitly local, unauthenticated Task API.
LOCAL_DEV_OPEN_TASK_API=0

# DATABASE_URL and REDIS_URL are derived inside the Compose services.

ARTIFACT_STORAGE_ROOT=/workspace/task-outputs
ARTIFACT_DOWNLOAD_ROOT=/workspace/task-outputs
METHOD_SOURCE_UPLOAD_ROOT=/workspace/task-inputs/method-sources
DATASET_UPLOAD_ROOT=/workspace/task-inputs/datasets
GOAL_DRIVEN_FIXTURE_ROOT=
ACCEPTANCE_FIXTURE_HOST_ROOT=/absolute/path/to/fixture/root
CODE_AGENT_DOCKER_IMAGE=claude-code-env:v2
CODE_AGENT_EXECUTOR_MODE=fixture
ALLOW_FIXTURE_EXECUTOR=1

# This is intentionally explicit in acceptance. It is not a production claim.
CODE_AGENT_JOB_NETWORK=none

# Acceptance Workers use the same persistent per-Worker credential as local
# Workers. Put the credentials returned by Add Worker into the two variables
# above before starting worker-a/worker-b.
ACCEPTANCE_WORKER_ENROLLMENT_REQUIRED=1
