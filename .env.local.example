# Infinity Agents local configuration.
# Copy this file to .env.local. PostgreSQL must be installed and started by
# the operating system; the startup script never starts Docker or Redis.

# Native PostgreSQL connection. Leave DATABASE_URL empty to derive it from the
# fields below. If the password contains URL-reserved characters, set a URL
# encoded DATABASE_URL instead.
PG_HOST=127.0.0.1
PG_PORT=5432
POSTGRES_DB=infinity_local
POSTGRES_USER=infinity
POSTGRES_PASSWORD=
DATABASE_URL=
LOCAL_RUNTIME_DATABASE_URL=

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8008
API_PROXY_TARGET=
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DB_MIGRATIONS_ENABLED=1

# Absolute, non-nested host directories. The startup script supplies
# repository-local defaults when these are left empty.
LOCAL_DATA_ROOT=
LOCAL_OBJECT_ROOT=
WORKER_WORK_ROOT=
ARTIFACT_STORAGE_ROOT=
ARTIFACT_DOWNLOAD_ROOT=
METHOD_SOURCE_UPLOAD_ROOT=
DATASET_UPLOAD_ROOT=
RESOURCE_STORAGE_ROOT=

# Local Worker control plane. The Worker polls PostgreSQL-backed HTTP routes;
# there is no Redis URL, relay URL, or queue configuration.
WORKER_CONTROL_PLANE_URL=http://127.0.0.1:8008
WORKER_LEASE_REQUEST_TIMEOUT_SECONDS=15
WORKER_RETRY_DELAY_SECONDS=5
WORKER_TASK_TIMEOUT_SECONDS=43200
WORKER_PUBLIC_NAMESPACE=local
WORKER_1_ID=
WORKER_1_CREDENTIAL=

# Claude provider settings. These are passed only to the Worker child.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
CLAUDE_CLI_PATH=
# Claude's permission machinery is kept enabled. Bash(*) is explicit because
# scientific tasks execute generated scripts; this is trusted current-user
# execution, not an OS filesystem sandbox.
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep,Bash(*)

# The startup script starts the API, the frontend when frontend/node_modules
# exists, and one Worker when WORKER_1_ID/CREDENTIAL are set.
START_FRONTEND=1
