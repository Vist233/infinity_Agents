# Direct Worker image: Claude Code runs as a child process in this container.
# There is deliberately no Docker CLI and no Docker socket mount.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    build-essential \
    util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv

ENV PATH="/opt/venv/bin:${PATH}"

RUN npm install --global @anthropic-ai/claude-code

# The supervisor needs the control-plane connections, but Claude Code must not
# run as that same UID: a prompt-injected task could otherwise inspect the
# supervisor's initial environment through /proc.  The runtime drops Claude
# to this user with setpriv before starting the child process.
RUN groupadd --system --gid 10001 claude \
    && useradd --system --uid 10001 --gid 10001 --create-home --home-dir /home/claude claude

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
RUN mkdir -p /workspace/task-workdirs /workspace/task-outputs

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV CODE_AGENT_EXECUTOR_MODE=direct
ENV CLAUDE_CODE_ALLOW_ALL=1
ENV DIRECT_CLAUDE_REQUIRE_PRIVDROP=1

CMD ["python", "-m", "backend.code_agent.worker.consumer", "worker-default"]
