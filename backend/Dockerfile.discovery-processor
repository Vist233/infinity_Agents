# Dedicated Discovery Processor image. The runtime has no database or bucket
# credentials; it receives only the short-lived Edge session capability and
# commits durable state through the fixed HTTPS control protocol.
# Use a public ECR mirror by default. The Windows compose deployment overrides
# this with a locally preloaded tag so the SSH build never needs registry creds.
ARG DISCOVERY_PYTHON_BASE=public.ecr.aws/docker/library/python:3.12-slim
FROM ${DISCOVERY_PYTHON_BASE}

RUN groupadd --system --gid 10003 discoveryprocessor \
    && useradd --system --uid 10003 --gid 10003 --create-home --home-dir /home/discoveryprocessor discoveryprocessor

WORKDIR /app
COPY backend/__init__.py ./backend/__init__.py
COPY backend/discovery ./backend/discovery
RUN mkdir -p /var/lib/discovery-processor \
    && chown -R 10003:10003 /app /home/discoveryprocessor /var/lib/discovery-processor

USER 10003:10003
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV DISCOVERY_PROCESSOR_WORK_ROOT=/var/lib/discovery-processor

CMD ["python", "-m", "backend.discovery.processor"]
