# Infinity Agents D1 Worker v2 image.
#
# The container has no PostgreSQL driver, Redis client, Docker CLI, Docker
# daemon, Docker socket, or verifier. It talks to Cloudflare D1/R2 through the
# HTTPS Worker v2 control plane and receives only fixed hints from the HTTPS
# Redis Relay. Claude Code runs directly as the non-root `claude` user.
FROM node:22-bookworm-slim

RUN set -eux; \
    for attempt in 1 2 3; do \
      apt-get -o Acquire::Retries=3 update; \
      if apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        python3 \
        python3-venv \
        build-essential \
        ca-certificates \
        curl \
        git \
        util-linux; then \
        break; \
      fi; \
      test "$attempt" -lt 3; \
      sleep 2; \
    done; \
    rm -rf /var/lib/apt/lists/*; \
    python3 -m venv /opt/venv

ENV PATH="/opt/venv/bin:${PATH}"

# Install the CLI in the image, never a provider credential. The version is a
# build input so the published digest is reproducible and can be revalidated
# after a Claude Code upgrade.
ARG CLAUDE_CODE_VERSION=2.1.226
RUN npm install --global "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && claude --version

# Claude Code is deliberately a separate non-root child process. The
# supervisor remains root so it can clean its own task volumes after upload.
RUN groupadd --system --gid 10001 claude \
    && useradd --system --uid 10001 --gid 10001 --create-home --home-dir /home/claude claude

WORKDIR /app
COPY requirements.worker.txt .
RUN pip install --no-cache-dir -r requirements.worker.txt

COPY backend/__init__.py ./backend/__init__.py
COPY backend/security.py ./backend/security.py
COPY backend/code_agent/__init__.py ./backend/code_agent/__init__.py
COPY backend/code_agent/worker/__init__.py ./backend/code_agent/worker/__init__.py
COPY backend/code_agent/worker/claude_runtime.py ./backend/code_agent/worker/claude_runtime.py
COPY backend/code_agent/worker/control_plane.py ./backend/code_agent/worker/control_plane.py
COPY backend/code_agent/worker/executor_v2.py ./backend/code_agent/worker/executor_v2.py
COPY backend/code_agent/worker/consumer_v2.py ./backend/code_agent/worker/consumer_v2.py
RUN mkdir -p /workspace/task-workdirs /workspace/task-outputs \
    && chown -R 10001:10001 /home/claude /workspace

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV CODE_AGENT_EXECUTOR_MODE=direct
ENV CLAUDE_CODE_ALLOW_ALL=1
ENV DIRECT_CLAUDE_REQUIRE_PRIVDROP=1
ENV CLAUDE_RUNTIME_UID=10001
ENV CLAUDE_RUNTIME_GID=10001
ENV CLAUDE_RUNTIME_HOME=/home/claude

CMD ["python", "-m", "backend.code_agent.worker.consumer_v2"]
