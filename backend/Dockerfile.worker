# Infinity Agents unified Worker image.
#
# This is the only production Worker image. It connects directly to the
# administrator-provided PostgreSQL and Redis cluster and runs the fixed
# Goal-Driven Claude Code runtime in this long-lived container. There is
# intentionally no Docker CLI, Docker daemon, or Docker socket.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    build-essential \
    ca-certificates \
    curl \
    git \
    util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv

ENV PATH="/opt/venv/bin:${PATH}"

# Install the CLI in the image, never a provider credential. The version is a
# build input so the published digest is reproducible and can be revalidated
# after a Claude Code upgrade.
ARG CLAUDE_CODE_VERSION=2.1.226
RUN npm install --global "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && claude --version

# Claude Code is deliberately a separate non-root child process. The
# supervisor remains root so it can clean its own task volumes after upload.
RUN groupadd --system --gid 10001 claude \
    && useradd --system --uid 10001 --gid 10001 --create-home --home-dir /home/claude claude

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
RUN mkdir -p /workspace/task-workdirs /workspace/task-outputs \
    && chown -R 10001:10001 /home/claude

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV CODE_AGENT_EXECUTOR_MODE=direct
ENV CLAUDE_CODE_ALLOW_ALL=1
ENV DIRECT_CLAUDE_REQUIRE_PRIVDROP=1
ENV CLAUDE_RUNTIME_UID=10001
ENV CLAUDE_RUNTIME_GID=10001
ENV CLAUDE_RUNTIME_HOME=/home/claude

CMD ["python", "-m", "backend.code_agent.worker.consumer", "worker-default"]
