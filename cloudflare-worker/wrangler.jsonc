{
  "name": "infinity-agents-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "infinity.zhangyvjing.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../frontend/out"
  },
  "vars": {
    "STEPFUN_BASE_URL": "https://api.stepfun.com/step_plan/v1",
    "STEPFUN_MODEL": "step-3.5-flash",

    "IMAGE_JUDGE_ZHANG_AUTH_ISSUER": "https://auth.zhangyvjing.com",
    "IMAGE_JUDGE_OIDC_CLIENT_ID": "image-judge-desktop",
    "IMAGE_JUDGE_OIDC_REDIRECT_URI": "https://infinity.zhangyvjing.com/image-judge/auth/callback",
    "IMAGE_JUDGE_DASHSCOPE_BASE_URL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "IMAGE_JUDGE_MODEL_ID": "qwen3-vl-235b-a22b-instruct",
    "IMAGE_JUDGE_DAILY_QUOTA": "30",
    "IMAGE_JUDGE_ACCESS_TOKEN_TTL_SECONDS": "900",
    "IMAGE_JUDGE_REFRESH_TOKEN_TTL_SECONDS": "2592000",
    "IMAGE_JUDGE_MAX_IMAGE_BYTES": "10485760"
  },
  "d1_databases": [
    {
      "binding": "IMAGE_JUDGE_DB",
      "database_name": "image-judge-db",
      "database_id": "fc8f0491-3d57-48d8-bae8-96f633d7dc8d",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "IMAGE_JUDGE_KV",
      "id": "fe1f3e47f5a94e4ca2b375ff3f9b2c79"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "IMAGE_JUDGE_USER_LOCK",
        "class_name": "ImageJudgeUserConcurrencyLock"
      }
    ]
  },
  "migrations": [
    {
      // 远端已登记此 tag；保留它以避免重复迁移同一个 DO 类。
      "tag": "v2-image-judge",
      "new_sqlite_classes": ["ImageJudgeUserConcurrencyLock"]
    }
  ],

  // Secrets are temporary validation credentials; remove the platform model key after testing.
  // wrangler secret put IMAGE_JUDGE_ZHANG_AUTH_CLIENT_SECRET
  // wrangler secret put IMAGE_JUDGE_TOKEN_SIGNING_SECRET
  // wrangler secret put IMAGE_JUDGE_DASHSCOPE_API_KEY
}
