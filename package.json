{
  "name": "sakura-infinity",
  "version": "0.1.1",
  "type": "module",
  "description": "Run many agents in parallel on one task and keep the best result: a code task scored by your evaluator, or a Lean 4 proof. Built on sakura-agent.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "view": "node bin/infinity.ts view",
    "coverage": "vitest run --coverage --coverage.provider=v8",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "infinity": "node bin/infinity.ts",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "sakura-agent": "^0.2.3",
    "sakura-agent-tools": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "bin": {
    "infinity": "dist/bin/infinity.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vist233/infinity_Agents.git"
  },
  "keywords": [
    "agents",
    "llm",
    "parallel",
    "benchmark",
    "lean4",
    "sakura-agent"
  ],
  "files": [
    "dist",
    "README.md",
    "AGENT-GUIDE.md",
    "LICENSE"
  ]
}
