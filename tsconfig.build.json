{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "src/**/*.ts",
    "bin/**/*.ts",
    "viewer/*.ts",
    "tasks/math-*/**/*.ts"
  ],
  "exclude": [
    "**/test/**",
    "**/*.test.ts"
  ]
}
