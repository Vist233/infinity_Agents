# Copy this file to worker-a.cloudflare.env and worker-b.cloudflare.env.
# Keep both files local and chmod 600; they contain bearer/provider secrets.

# Cloudflare control/API address. This is not a direct D1 SQL URL.
CONTROL_BASE_URL=https://infinity.zhangyvjing.com

# One server-created Worker ID and its matching persistent credential.
WORKER_ID=worker-replace-me
# User-owned Workers may use a user namespace. Platform public Workers use
# the fixed namespace returned by the Public Worker admin panel: infinity-public.
WORKER_NAMESPACE=infinity
WORKER_CREDENTIAL=replace-with-persistent-worker-credential
# Stable per-machine value. Worker B must use a different value.
WORKER_INSTANCE_ID=mac-worker-a

# The compose file overrides these per Worker with isolated named volumes.
# Keep the names aligned if you run one Worker manually instead of compose.
WORKER_WORK_ROOT=/worker-inputs
WORKER_OUTPUT_ROOT=/worker-outputs
CODE_AGENT_INPUT_VOLUME=infinity-agents-worker-a-inputs
CODE_AGENT_OUTPUT_VOLUME=infinity-agents-worker-a-outputs
CODE_AGENT_INPUT_VOLUME_ROOT=/worker-inputs
CODE_AGENT_OUTPUT_VOLUME_ROOT=/worker-outputs

# Redis is optional for the Cloudflare control-plane Worker. If a local
# deployment also needs the existing remote Redis, put REDIS_URL in this local
# file and set WORKER_REDIS_REQUIRED=1. Never start a second Redis container.
WORKER_REDIS_REQUIRED=0

# Claude Code runs directly inside the Worker container. Fill the following
# values only in this local file; Compose passes them to the container and the
# Worker never sends them to Cloudflare:
ANTHROPIC_BASE_URL=replace-with-your-anthropic-base-url
ANTHROPIC_MODEL=replace-with-your-anthropic-model
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_DEFAULT_OPUS_MODEL / ANTHROPIC_DEFAULT_SONNET_MODEL / ANTHROPIC_DEFAULT_HAIKU_MODEL
# CLAUDE_CODE_* model settings
WORKER_POLL_INTERVAL=5
WORKER_VERSION=cloudflare-claude-worker/1
# One task per container lifecycle. Compose restarts the container for the next
# task after local input/output cleanup completes.
WORKER_RECYCLE_AFTER_TASK=1
