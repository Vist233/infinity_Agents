# Infinity Agents D1 Worker v2 configuration.
# Copy to worker-b.cloudflare.env and restrict the copy to the Worker account.
# Never commit the filled file. No PostgreSQL URL, Redis admin URL, D1 token,
# R2 parent key, or Cloudflare Account token belongs in this file.

# Administrator-issued immutable image reference.
WORKER_IMAGE=ghcr.io/vist233/infinity-agent-worker@sha256:c20e098a2a96be9fb36480a8bcb922aab0d50087f80a68239f4fb26a333fd43c
WORKER_IMAGE_DIGEST=sha256:c20e098a2a96be9fb36480a8bcb922aab0d50087f80a68239f4fb26a333fd43c

# One persistent server-issued identity for this container.
# Create another Worker credential for another container; never reuse one.
WORKER_ID=public-worker-replace-me
WORKER_CREDENTIAL=replace-with-persistent-worker-credential
WORKER_INSTANCE_ID=windows-worker-b-replace-me
WORKER_PROTOCOL_VERSION=2
WORKER_RUNTIME_CAPABILITY=goal-driven-claude-code

# Administrator-provided public HTTPS endpoints. The server binds the Worker
# to public-default / infinity-public from D1; do not add Namespace or Pool.
WORKER_CONTROL_PLANE_URL=https://infinity.zhangyvjing.com
WORKER_RELAY_URL=https://redis-relay.example.com
WORKER_RELAY_HINT_TOKEN=replace-with-worker-hint-token

# Existing trusted Claude Code provider configuration. Fill these three
# values from the administrator's approved environment; use either API key or
# auth token as required by that provider, never a fabricated default.
ANTHROPIC_BASE_URL=https://api.example.com/anthropic
ANTHROPIC_MODEL=replace-with-existing-model
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# Runtime defaults. Provider credentials are passed only to the non-root
# Claude child; Worker credential and Relay token are never passed to it.
APP_ENV=production
CODE_AGENT_EXECUTOR_MODE=direct
CLAUDE_CODE_ALLOW_ALL=1
WORKER_TASK_TIMEOUT_SECONDS=43200
WORKER_TRANSFER_TIMEOUT_SECONDS=600
