# Copy to worker-b.cloudflare.env and restrict the file to the Worker account.
# This file contains machine/provider secrets. Never commit the copy.

# Administrator-issued, immutable image reference.
WORKER_IMAGE=ghcr.io/<org-or-user>/infinity-agent-worker@sha256:<verified-digest>

# One persistent server-issued identity for this container.
WORKER_ID=worker-replace-me
WORKER_CREDENTIAL=replace-with-persistent-worker-credential
WORKER_INSTANCE_ID=windows-worker-b-replace-me
WORKER_PROTOCOL_VERSION=1
WORKER_RUNTIME_CAPABILITY=goal-driven-claude-code
WORKER_IMAGE_DIGEST=sha256:<same-image-digest>

# Administrator-provided central API, PostgreSQL and Redis.
WORKER_CONTROL_PLANE_URL=https://central-api.example.com
WORKER_DATABASE_URL=postgresql://worker_role:password@db.example.com:5432/infinity_agents?sslmode=verify-full
WORKER_REDIS_URL=rediss://redis_user:password@redis.example.com:6380/0?ssl_cert_reqs=required
REDIS_NAMESPACE=infinity-public

# Local Claude Code provider configuration. Fill from the existing trusted
# environment; use either API key or auth token, not a fabricated default.
ANTHROPIC_BASE_URL=https://api.example.com/anthropic
ANTHROPIC_MODEL=replace-with-existing-model
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# Long-lived loop defaults.
WORKER_POLL_INTERVAL=5
WORKER_TASK_TIMEOUT_SECONDS=43200
WORKER_RECYCLE_AFTER_TASK=0
CODE_AGENT_EXECUTOR_MODE=direct
DB_RLS_ENABLED=1
DB_RLS_REQUIRE_CONTEXT=1
DB_RLS_WORKER_ROLE=infinity_worker
