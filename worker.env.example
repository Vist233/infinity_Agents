# Infinity Agent — Worker connection settings.
#
# Copy this file to worker.env and fill in the values. A new Worker machine
# only needs: Docker installed, this file configured, and the executor image
# (claude-code-env:v2) available locally. Then run:
#
#   docker compose -f docker-compose.local.yml --env-file worker.env up -d
#
# Or on a remote machine that only runs the worker container:
#
#   docker run -d --env-file worker.env \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     infinity-agent-worker:latest \
#     python -m backend.code_agent.worker.consumer worker-$(hostname)

# --- Required: Redis (task queue + event stream) ---
# Point at the Redis used by the API server, e.g. redis://192.168.1.10:6379/0
# If Redis has a password (recommended for production), include it:
#   redis://:your-password@192.168.1.10:6379/0
REDIS_URL=redis://localhost:6379/0

# Optional: enables requirepass on the compose-managed Redis container.
# Production deployments MUST set this (and match it in REDIS_URL above).
# REDIS_PASSWORD=

# --- Required: PostgreSQL (task state) ---
# NOTE: inside a container, the host machine is "host.docker.internal",
# never "localhost".
DATABASE_URL=postgresql://postgres@host.docker.internal:5450/infinity_agents

# --- Executor image used for Job Containers ---
CODE_AGENT_DOCKER_IMAGE=claude-code-env:v2

# --- LLM credentials passed through into Job Containers ---
ANTHROPIC_API_KEY=
# STEPFUN_API_KEY=

# --- Optional overrides ---
# Where the worker writes task artifacts. Inside the compose stack this is
# /workspace/task-outputs (mounted from ./workspace on the host), and the API
# server must read the same directory via ARTIFACT_DOWNLOAD_ROOT, e.g. run it
# with ARTIFACT_DOWNLOAD_ROOT=$(pwd)/workspace/task-outputs.
# ARTIFACT_STORAGE_ROOT=/workspace/task-outputs
# Fallback input data for legacy test cases (case 1/2/3 layout).
CODE_AGENT_CASE_DIR=/workspace/case
# Restrict Job Container network (design doc §24); leave empty to keep
# outbound HTTPS for the LLM API. Set to "none" for fully offline runs.
# CODE_AGENT_JOB_NETWORK=none
# Non-root user inside the executor image, if the image provides one.
# CODE_AGENT_JOB_USER=analyst
# Optional shared secret for the Task API (X-API-Key header; SSE streams use
# ?api_key=). When set, the browser frontend must be built/run with
# NEXT_PUBLIC_TASK_API_TOKEN=<same value>, otherwise the UI gets 401.
# PRODUCTION: must be set — without it the whole Task API (including worker
# and outbox endpoints) is open to anyone who can reach the server.
# TASK_API_TOKEN=
