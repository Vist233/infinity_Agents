# Infinity Agent — Worker connection settings.
#
# Copy this file to worker.env and fill in the values. A new Worker machine
# only needs Docker, this file, and network access to the shared Redis and
# PostgreSQL. Claude Code runs directly inside the Worker container; the
# Worker never mounts /var/run/docker.sock and never starts Docker-in-Docker.
#
#   docker compose -f docker-compose.local.yml --env-file worker.env up -d
#
# The Worker process keeps the control-plane credentials, while the Claude
# Code child receives only the explicitly named Anthropic/Claude settings.

# --- Required: Redis (task queue + event stream) ---
# When using docker-compose.local.yml, use the compose service name. For a
# remote central Redis, replace this with its TLS URL, e.g.
# rediss://:your-password@redis.example.com:6380/0?ssl_cert_reqs=required
APP_ENV=production
REDIS_URL=rediss://:replace-with-redis-password@redis.example.com:6380/0?ssl_cert_reqs=required
REDIS_NAMESPACE=replace-with-acceptance-or-production-namespace
WORKER_ID=worker-replace-me
WORKER_INSTANCE_ID=worker-instance-replace-me
WORKER_PROTOCOL_VERSION=1
WORKER_RUNTIME_CAPABILITY=goal-driven-claude-code
WORKER_IMAGE_DIGEST=

# This is the persistent credential returned by Add Worker. Store it in the
# local worker.env; it is not a one-time token.
WORKER_ENROLLMENT_REQUIRED=1
WORKER_CREDENTIAL=
# docker-compose.local.yml runs two distinct identities. Never reuse the
# same credential for both containers.
WORKER_A_CREDENTIAL=
WORKER_B_CREDENTIAL=

# The Worker scratch directory is private to that Worker. It downloads its
# two inputs and uploads the result archive via the credential-protected
# transfer endpoints. In the acceptance Compose network this is
# http://api:8008; in local Compose the default is
# http://host.docker.internal:8000; on another machine use the public HTTPS
# API URL. Production/remote Workers must use HTTPS.
# Required by docker-compose.local.yml. Use the public HTTPS API in production;
# for a disposable local-only run set APP_ENV=development and use:
# WORKER_CONTROL_PLANE_URL=http://host.docker.internal:8000
WORKER_CONTROL_PLANE_URL=https://infinity.zhangyvjing.com

# Required for the compose-managed Redis container. The service binds only to
# 127.0.0.1 on the host and the two Worker URLs above include this password.
REDIS_PASSWORD=replace-with-a-long-local-redis-password

# --- Required: PostgreSQL (task state) ---
# NOTE: inside a container, the host machine is "host.docker.internal",
# never "localhost".
# The two data-plane Workers use their own login. The API-side Worker gateway,
# Outbox, and Reaper use separate service logins and are configured on their
# respective server processes; do not reuse this Worker URL for them.
WORKER_DATABASE_URL=postgresql://worker_login:password@db.example.com:5432/infinity_agents?sslmode=verify-full
# The runtime pool switches to the NOBYPASSRLS Worker role and injects the
# Worker ID into app.worker_id on every connection checkout.
DB_RLS_ENABLED=1
DB_RLS_REQUIRE_CONTEXT=1
DB_RLS_WORKER_ROLE=infinity_worker

# These are consumed by the local Compose Outbox/Reaper services, not by
# Claude Code. They must be different non-superuser logins in a protected DB.
OUTBOX_DATABASE_URL=postgresql://outbox_login:password@host.docker.internal:5450/infinity_agents
REAPER_DATABASE_URL=postgresql://reaper_login:password@host.docker.internal:5450/infinity_agents

# --- Claude Code configuration ---
# Direct mode passes only an Attempt-scoped gateway capability to Claude Code.
# Do not put a long-lived provider key in the child environment. The control
# plane must mint these values for the current Attempt and revoke/expire them.
CODE_AGENT_EXECUTOR_MODE=direct
CLAUDE_CODE_ALLOW_ALL=1
ATTEMPT_GATEWAY_URL=
ATTEMPT_GATEWAY_TOKEN=
ATTEMPT_MODEL_ID=
# CLAUDE_CODE_COMMAND=claude
# CLAUDE_CODE_ARGS=

# --- Optional overrides ---
# Where the worker writes task scratch artifacts before the authenticated
# control-plane upload. Inside the compose stack this is private to the
# Worker at /workspace/task-outputs.
# ARTIFACT_STORAGE_ROOT=/workspace/task-outputs
# ARTIFACT_HOST_ROOT=/path/to/the/control-plane/artifact-root
# Fallback input data for legacy test cases (case 1/2/3 layout).
CODE_AGENT_CASE_DIR=/workspace/case
# CODE_AGENT_JOB_NETWORK and CODE_AGENT_JOB_USER are legacy nested-Docker
# settings and are intentionally unused by direct mode.
