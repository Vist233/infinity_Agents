# Legacy filename kept as a pointer for scripts that still reference it.
# Use worker.cloudflare.env.example for the only supported D1 Worker v2 path.
# This file intentionally contains no PostgreSQL, DATABASE_URL, Redis URL,
# RLS, Namespace, or Pool configuration.

WORKER_IMAGE=ghcr.io/<org-or-user>/infinity-agent-worker@sha256:<verified-digest>
WORKER_IMAGE_DIGEST=sha256:<same-image-digest>
WORKER_ID=public-worker-replace-me
WORKER_CREDENTIAL=replace-with-persistent-worker-credential
WORKER_INSTANCE_ID=worker-instance-replace-me
WORKER_PROTOCOL_VERSION=2
WORKER_RUNTIME_CAPABILITY=goal-driven-claude-code
WORKER_CONTROL_PLANE_URL=https://infinity.zhangyvjing.com
WORKER_RELAY_URL=https://redis-relay.example.com
WORKER_RELAY_HINT_TOKEN=replace-with-worker-hint-token

ANTHROPIC_BASE_URL=https://api.example.com/anthropic
ANTHROPIC_MODEL=replace-with-existing-model
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

APP_ENV=production
CODE_AGENT_EXECUTOR_MODE=direct
CLAUDE_CODE_ALLOW_ALL=1
WORKER_TASK_TIMEOUT_SECONDS=43200
WORKER_TRANSFER_TIMEOUT_SECONDS=600
